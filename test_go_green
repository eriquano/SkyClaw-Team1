#!/usr/bin/env python3
"""
go_green.py — PX4 ROS2 Mission
Search green box with front camera → center using downward camera → hover → return.
"""

import rclpy
from rclpy.node import Node
from sensor_msgs.msg import Image
from geometry_msgs.msg import PoseStamped
from mavros_msgs.msg import State
from cv_bridge import CvBridge
import cv2
import numpy as np
import time
import math

# --- Tunable parameters ---
LOWER_GREEN = np.array([40, 40, 40])
UPPER_GREEN = np.array([80, 255, 255])
PIXEL_TO_METER = 0.005      # scale factor, tune per camera
APPROACH_SPEED = 0.3
CENTER_TOL = 40             # pixel tolerance for "centered"
HOVER_TIME = 5.0            # seconds
SEARCH_YAW_RATE = 0.25      # rad/s, used for scanning with front cam
DOWNWARD_TRIGGER_ALT = 1.5  # meters (below which we switch to down cam)
# ----------------------------

class GoGreen(Node):
    def __init__(self):
        super().__init__('go_green')

        self.bridge = CvBridge()

        # State
        self.pose = None
        self.state = None
        self.start_pose = None

        # Detection flags
        self.front_target = None
        self.down_target = None
        self.phase = "search_front"  # search_front → approach → refine_down → hover → return
        self.hover_start = None

        # Subscribers
        self.create_subscription(Image, '/camera_front/image_raw', self.front_cam_cb, 10)
        self.create_subscription(Image, '/camera_down/image_raw', self.down_cam_cb, 10)
        self.create_subscription(PoseStamped, '/mavros/local_position/pose', self.pose_cb, 10)
        self.create_subscription(State, '/mavros/state', self.state_cb, 10)

        # Publisher
        self.setpoint_pub = self.create_publisher(PoseStamped, '/mavros/setpoint_position/local', 10)

        self.timer = self.create_timer(0.1, self.loop)
        self.get_logger().info("go_green node started")

    # ----------------- Callbacks ----------------- #
    def state_cb(self, msg):
        self.state = msg

    def pose_cb(self, msg):
        self.pose = msg
        if self.start_pose is None:
            self.start_pose = msg.pose
            self.get_logger().info("Start pose recorded.")

    def front_cam_cb(self, msg):
        self.front_target = self.process_image(msg, "Front Camera")

    def down_cam_cb(self, msg):
        self.down_target = self.process_image(msg, "Downward Camera")

    # ----------------- Image Processing ----------------- #
    def process_image(self, msg, window_name):
        cv_image = self.bridge.imgmsg_to_cv2(msg, desired_encoding='bgr8')
        hsv = cv2.cvtColor(cv_image, cv2.COLOR_BGR2HSV)
        mask = cv2.inRange(hsv, LOWER_GREEN, UPPER_GREEN)
        mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, np.ones((5,5), np.uint8))

        contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        if not contours:
            cv2.imshow(window_name, cv_image)
            cv2.waitKey(1)
            return None

        cnt = max(contours, key=cv2.contourArea)
        if cv2.contourArea(cnt) < 200:
            cv2.imshow(window_name, cv_image)
            cv2.waitKey(1)
            return None

        x, y, w, h = cv2.boundingRect(cnt)
        cx = x + w // 2
        cy = y + h // 2
        h_img, w_img = cv_image.shape[:2]
        dx = cx - w_img // 2
        dy = cy - h_img // 2

        # Draw UI
        cv2.rectangle(cv_image, (x, y), (x + w, y + h), (0, 255, 0), 2)
        cv2.circle(cv_image, (cx, cy), 5, (0, 0, 255), -1)
        cv2.putText(cv_image, f"dX:{dx} dY:{dy}", (cx + 10, cy - 10),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 255), 1)
        cv2.imshow(window_name, cv_image)
        cv2.waitKey(1)

        return (dx, dy)

    # ----------------- Mission Logic ----------------- #
    def loop(self):
        if self.pose is None or self.start_pose is None:
            return

        phase = self.phase

        if phase == "search_front":
            if self.front_target is not None:
                self.phase = "approach_front"
                self.get_logger().info("Target detected — approaching...")
            else:
                # rotate slowly to scan
                self.rotate_in_place(SEARCH_YAW_RATE)
                self.get_logger().info_throttle(2.0, "Searching for green box...")

        elif phase == "approach_front":
            dx, dy = self.front_target if self.front_target else (0, 0)
            if abs(dx) < CENTER_TOL:
                # Move forward slowly
                self.fly_relative(0.5 * APPROACH_SPEED, 0.0, 0.0)
                if self.pose.pose.position.z < DOWNWARD_TRIGGER_ALT and self.down_target is not None:
                    self.phase = "refine_down"
                    self.get_logger().info("Switching to downward camera for refinement.")
            else:
                self.fly_relative(0.0, -dx * PIXEL_TO_METER, 0.0)

        elif phase == "refine_down":
            if self.down_target is None:
                self.get_logger().info_throttle(1.0, "Lost target in downward cam.")
                return
            dx, dy = self.down_target
            if abs(dx) < CENTER_TOL and abs(dy) < CENTER_TOL:
                if self.hover_start is None:
                    self.hover_start = time.time()
                    self.get_logger().info("Centered above target — hovering...")
                elif time.time() - self.hover_start > HOVER_TIME:
                    self.phase = "return_home"
                    self.get_logger().info("Hover complete. Returning home.")
            else:
                self.fly_relative(-dx * PIXEL_TO_METER, -dy * PIXEL_TO_METER, 0.0)

        elif phase == "return_home":
            self.fly_to(self.start_pose.position.x,
                        self.start_pose.position.y,
                        self.start_pose.position.z)
            # Optionally land or stop after reaching home
            self.get_logger().info_throttle(3.0, "Returning to start position...")

    # ----------------- Motion Control ----------------- #
    def fly_relative(self, dx, dy, dz):
        """Send a position offset relative to current pose."""
        target = PoseStamped()
        target.header.stamp = self.get_clock().now().to_msg()
        target.pose.position.x = self.pose.pose.position.x + dx
        target.pose.position.y = self.pose.pose.position.y + dy
        target.pose.position.z = self.pose.pose.position.z + dz
        target.pose.orientation = self.pose.pose.orientation
        self.setpoint_pub.publish(target)

    def fly_to(self, x, y, z):
        target = PoseStamped()
        target.header.stamp = self.get_clock().now().to_msg()
        target.pose.position.x = x
        target.pose.position.y = y
        target.pose.position.z = z
        target.pose.orientation = self.pose.pose.orientation
        self.setpoint_pub.publish(target)

    def rotate_in_place(self, yaw_rate):
        """Simple yaw rotation via orientation change."""
        target = PoseStamped()
        target.header.stamp = self.get_clock().now().to_msg()
        target.pose = self.pose.pose
        # add small yaw increment (simplified, assumes quaternion yaw only)
        current_yaw = self.get_yaw_from_pose(self.pose.pose)
        new_yaw = current_yaw + yaw_rate * 0.1
        target.pose.orientation = self.yaw_to_quaternion(new_yaw)
        self.setpoint_pub.publish(target)

    # --- Utility for quaternion handling --- #
    def get_yaw_from_pose(self, pose):
        q = pose.orientation
        siny_cosp = 2 * (q.w * q.z + q.x * q.y)
        cosy_cosp = 1 - 2 * (q.y * q.y + q.z * q.z)
        return math.atan2(siny_cosp, cosy_cosp)

    def yaw_to_quaternion(self, yaw):
        import geometry_msgs.msg
        q = geometry_msgs.msg.Quaternion()
        q.w = math.cos(yaw / 2)
        q.x = 0.0
        q.y = 0.0
        q.z = math.sin(yaw / 2)
        return q

# ----------------- MAIN ----------------- #
def main():
    rclpy.init()
    node = GoGreen()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()
        cv2.destroyAllWindows()

if __name__ == '__main__':
    main()
